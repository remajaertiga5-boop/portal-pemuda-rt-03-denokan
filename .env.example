# ============================================================
# FILE   : .env.example
# SALIN  : cp .env.example .env.local
# JANGAN : commit .env.local ke GitHub!
# ============================================================
# Pastikan .gitignore berisi:
#   .env.local
#   .env.*.local
#   .env.production
# ============================================================

# ============================================================
# PUBLIC VARIABLES — Prefix VITE_
# ✅ Aman diakses di browser via import.meta.env.VITE_xxx
# ============================================================

# ── App Info ──────────────────────────────────────────────
VITE_APP_TITLE=Portal Pemuda RT 03
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Portal Remaja Legok 03 RT 03/RW 04 Denokan
VITE_APP_URL=https://remaja-legok-03.vercel.app

# ── Organisasi ────────────────────────────────────────────
VITE_ORG_NAME=Remaja RT 03 RW 04 Denokan
VITE_ORG_ALAMAT=Denokan, Gondoryo, Jambu, Semarang

# ── API & Backend ─────────────────────────────────────────
# URL Google Apps Script yang sudah di-deploy sebagai Web App
# Contoh: https://script.google.com/macros/s/AKfycbx.../exec
VITE_API_URL=

# Timeout request API dalam milidetik (default: 15000)
VITE_API_TIMEOUT=15000

# ── Google Sheets ─────────────────────────────────────────
# Hanya Spreadsheet ID (bukan URL penuh, bukan credentials)
# Contoh: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
VITE_SHEETS_ID=

# ── Google Drive ──────────────────────────────────────────
# Folder ID untuk upload file ke Drive (hanya ID, bukan credentials)
VITE_DRIVE_FOLDER_ID=

# ── Cloudflare R2 ─────────────────────────────────────────
# URL publik R2 bucket (aman, bisa diakses browser)
# Contoh: https://pub-xxxxxxxxxxxxxxxx.r2.dev
VITE_R2_PUBLIC_URL=

# ── Upload ────────────────────────────────────────────────
# URL endpoint upload (via Vercel serverless /api/upload-r2)
VITE_UPLOAD_URL=/api/upload-r2

# ── Feature Flags ─────────────────────────────────────────
# Aktifkan fitur AI Chatbot ("true" | "false")
VITE_ENABLE_AI=true

# Aktifkan upload foto ke Cloudflare R2 ("true" | "false")
# Jika false, upload akan fallback ke Google Drive
VITE_ENABLE_R2=false

# ============================================================
# SECRET VARIABLES — Tanpa prefix VITE_
# ❌ TIDAK bisa diakses di browser
# ✅ Hanya bisa diakses di /api/* (Vercel Serverless Functions)
# ============================================================

# ── Google Apps Script ────────────────────────────────────
# URL lengkap Apps Script — JANGAN ekspos ke browser!
# Contoh: https://script.google.com/macros/s/AKfycbx.../exec
GOOGLE_SCRIPT_URL=

# ── Google Service Account (opsional — jika pakai Sheets API)
# Download dari Google Cloud Console → Service Accounts → JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ── Cloudflare R2 Credentials ─────────────────────────────
# RAHASIA — jangan pernah ekspos ke client/browser!
# Dapatkan dari: Cloudflare Dashboard → R2 → Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=remaja-legok-03
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ── Vercel / Deployment ───────────────────────────────────
# Otomatis diisi Vercel saat deploy — tidak perlu diisi manual
# VERCEL_URL=
# VERCEL_ENV=

# ============================================================
# CARA PAKAI DI KODE
# ============================================================
# Browser (komponen React):
#   import.meta.env.VITE_API_URL
#   import.meta.env.VITE_APP_TITLE
#
# Server (Vercel /api/*.ts):
#   process.env.GOOGLE_SCRIPT_URL
#   process.env.R2_ACCESS_KEY_ID
#
# Cek apakah tersedia:
#   const apiUrl = import.meta.env.VITE_API_URL ?? ''
#   if (!apiUrl) console.warn('VITE_API_URL belum diisi!')
# ============================================================
