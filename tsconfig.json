{
  "compilerOptions": {

    // ----------------------------------------------------------
    // TARGET & MODULE
    // ----------------------------------------------------------
    "target"    : "ES2022",
    "module"    : "ESNext",
    "lib"       : ["ES2022", "DOM", "DOM.Iterable"],

    // ----------------------------------------------------------
    // MODULE RESOLUTION
    // ----------------------------------------------------------
    "moduleResolution"      : "bundler",
    "moduleDetection"       : "force",
    "isolatedModules"       : true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule"     : true,

    // ----------------------------------------------------------
    // JSX
    // ----------------------------------------------------------
    "jsx": "react-jsx",

    // ----------------------------------------------------------
    // STRICT & TYPE CHECKING
    // ✅ Fix Bug 1: Aktifkan strict mode
    // ----------------------------------------------------------
    "strict"                    : true,
    "noUnusedLocals"            : false,
    "noUnusedParameters"        : false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess"  : false,
    "exactOptionalPropertyTypes": false,

    // ----------------------------------------------------------
    // CLASS & DECORATORS
    // ----------------------------------------------------------
    "experimentalDecorators"  : true,
    "useDefineForClassFields" : false,

    // ----------------------------------------------------------
    // PATHS & ALIASES
    // ✅ Fix Bug 2: Arahkan @/* ke src/
    // ✅ Fix Bug 4: Tambah baseUrl
    // ----------------------------------------------------------
    "baseUrl": ".",
    "paths": {
      "@/*"         : ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@lib/*"      : ["./src/lib/*"],
      "@hooks/*"    : ["./src/hooks/*"],
      "@context/*"  : ["./src/context/*"],
      "@types/*"    : ["./src/types/*"],
      "@locales/*"  : ["./src/locales/*"]
    },

    // ----------------------------------------------------------
    // MISC
    // ----------------------------------------------------------
    "allowJs"     : true,
    "skipLibCheck": true,
    "noEmit"      : true
  },

  // ✅ Fix Bug 3: Tambah include & exclude
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "api/**/*.ts",
    "vite.config.ts",
    "server.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "apps-script",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}